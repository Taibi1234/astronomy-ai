import hashlib
import json
import math
from functools import lru_cache
from pathlib import Path

import numpy as np
import pandas as pd
import transit_injection
from fastapi import FastAPI, HTTPException, Query
from fastapi.middleware.cors import CORSMiddleware
from fastapi.responses import FileResponse, PlainTextResponse
from pydantic import BaseModel, Field
from research.jobs import manager as recovery_manager

app = FastAPI(
    title="Astronomy AI Observatory API",
    description="Read-only API for the astronomy-ai research project.",
    version="0.3.0",
)

# Local development only. Restrict this before public deployment.
app.add_middleware(
    CORSMiddleware,
    allow_origins=[
        "http://localhost:5173",
        "http://localhost:5174",
        "http://127.0.0.1:5173",
        "http://127.0.0.1:5174",
    ],
    allow_credentials=False,
    allow_methods=["GET"],
    allow_headers=["*"],
)

# app.py -> backend -> webapp -> repository root
PROJECT_ROOT = Path(__file__).resolve().parents[2]

ARTIFACTS = {
    "Kepler processed light curve": "data/processed/kepler_kepler_10.csv",
    "TESS processed light curve": "data/processed/tess_kepler_10.csv",
    "Phase 8 synthetic dataset": "reports/phase8_dataset.json",
    "Phase 4 statistical validation": ("reports/phase4_statistical_validation.md"),
    "Phase 5 ML results": "reports/phase5_results.json",
    "Phase 5 ML dataset": "reports/phase5_dataset.json",
    "Phase 5 feature configuration": "reports/phase5_feature_config.json",
}

DATASETS = {
    "kepler": "data/processed/kepler_kepler_10.csv",
    "tess": "data/processed/tess_kepler_10.csv",
}


def read_json_report(relative_path: str):
    """Read a JSON research report without modifying its source file."""
    path = PROJECT_ROOT / relative_path

    if not path.is_file():
        raise HTTPException(
            status_code=404,
            detail=f"Research report not found: {relative_path}",
        )

    try:
        with path.open("r", encoding="utf-8-sig") as file:
            return json.load(file)
    except json.JSONDecodeError as exc:
        raise HTTPException(
            status_code=500,
            detail=f"Invalid JSON in research report: {relative_path}",
        ) from exc
    except OSError as exc:
        raise HTTPException(
            status_code=500,
            detail=f"Could not read research report: {relative_path}",
        ) from exc


@app.get("/api/health")
def health():
    return {
        "status": "ok",
        "service": "astronomy-ai-api",
    }


@app.get("/api/project")
def project():
    return {
        "name": "Astronomy AI Observatory",
        "target": "Kepler-10 b",
        "method": "Transit photometry",
        "orbital_period_days": 0.837491225,
        "purpose": (
            "Explore exoplanet transit analysis, statistical validation, "
            "and machine-learning experiments."
        ),
        "scientific_notice": (
            "Machine-learning experiments using synthetic injections "
            "are not evidence of a new exoplanet discovery."
        ),
    }


@app.get("/api/artifacts")
def artifacts():
    results = []

    for name, relative_path in ARTIFACTS.items():
        path = PROJECT_ROOT / relative_path
        available = path.is_file()

        results.append(
            {
                "name": name,
                "path": relative_path,
                "available": available,
                "size_bytes": path.stat().st_size if available else None,
            }
        )

    return {
        "repository_root": str(PROJECT_ROOT),
        "artifacts": results,
    }


@app.get("/api/ml-results")
def ml_results():
    """
    Return report-backed Phase 5 results and a compact dataset summary.

    This endpoint reports saved experiment results. It does not train a
    model, calculate new performance metrics, or claim a planet discovery.
    """
    results = read_json_report("reports/phase5_results.json")
    dataset = read_json_report("reports/phase5_dataset.json")
    config = read_json_report("reports/phase5_feature_config.json")

    required_result_keys = (
        "precision",
        "recall",
        "f1",
        "roc_auc",
        "pr_auc",
        "n_train",
        "n_val",
        "n_test",
        "baseline_f1",
        "rf_f1_validation",
        "rf_selected",
        "rf_f1_test",
        "confusion_matrix",
        "feature_list",
        "label_source_note",
        "split_strategy",
        "synthetic_only_warning",
        "no_discovery_claim",
    )

    missing_keys = [key for key in required_result_keys if key not in results]

    if missing_keys:
        raise HTTPException(
            status_code=500,
            detail=(
                "Phase 5 results report is missing required fields: " + ", ".join(missing_keys)
            ),
        )

    windows = dataset.get("windows", [])

    if not isinstance(windows, list):
        raise HTTPException(
            status_code=500,
            detail="Phase 5 dataset has an invalid windows field.",
        )

    positive_count = sum(
        1 for window in windows if isinstance(window, dict) and window.get("is_positive") is True
    )
    negative_count = sum(
        1 for window in windows if isinstance(window, dict) and window.get("is_positive") is False
    )

    # Summarize positive injection depths when that field is available.
    depth_counts = {}

    for window in windows:
        if not isinstance(window, dict):
            continue

        if window.get("is_positive") is not True:
            continue

        depth = window.get("injected_depth_ppm")

        if isinstance(depth, (int, float)) and math.isfinite(depth):
            depth_number = float(depth)
            depth_key = str(int(depth_number)) if depth_number.is_integer() else str(depth_number)
            depth_counts[depth_key] = depth_counts.get(depth_key, 0) + 1

    # The feature configuration's exact structure may vary by report
    # version, so return it intact rather than guessing its schema.
    return {
        "experiment": {
            "phase": 5,
            "target": "Kepler-10 b",
            "n_windows": len(windows),
            "positive_windows": positive_count,
            "negative_windows": negative_count,
            "seed": dataset.get("seed"),
            "window_hours": dataset.get("window_hours"),
            "positive_depths_ppm": dataset.get("positive_depths_ppm"),
            "negative_depth_ppm": dataset.get("negative_depth_ppm"),
            "positive_depth_counts": depth_counts,
            "label_source_note": results.get("label_source_note"),
            "split_strategy": results.get("split_strategy"),
        },
        "results": results,
        "feature_config": config,
        "provenance": {
            "results": "reports/phase5_results.json",
            "dataset": "reports/phase5_dataset.json",
            "feature_config": "reports/phase5_feature_config.json",
        },
        "scientific_notice": (
            "This experiment uses synthetic transit injections. "
            "Performance on simulated windows does not establish "
            "generalization to real observations and is not evidence "
            "of a new exoplanet discovery."
        ),
    }


@lru_cache(maxsize=4)
def _file_sha256(path_str: str, mtime_ns: int) -> str:
    """Checksum of an unmodified source file, cached per file version."""
    digest = hashlib.sha256()
    with open(path_str, "rb") as handle:
        for block in iter(lambda: handle.read(1 << 20), b""):
            digest.update(block)
    return digest.hexdigest()


RECOVERY_DIR = PROJECT_ROOT / "reports" / "injection_recovery"

# Exact allowlist: client-supplied names never become filesystem paths.
RECOVERY_ARTIFACTS = {
    "summary.json": ("summary.json", "application/json"),
    "config.json": ("config.json", "application/json"),
    "provenance.json": ("provenance.json", "application/json"),
    "plot_data.json": ("plot_data.json", "application/json"),
    "trial_results.csv": ("trial_results.csv", "text/csv"),
    "recovery_report.md": ("recovery_report.md", "text/markdown"),
    "recovery_vs_depth.png": ("figures/recovery_vs_depth.png", "image/png"),
    "control_snr.png": ("figures/control_snr.png", "image/png"),
    "recovered_vs_injected.png": ("figures/recovered_vs_injected.png", "image/png"),
    "timing_error.png": ("figures/timing_error.png", "image/png"),
    "benchmark_f1.png": ("figures/benchmark_f1.png", "image/png"),
}


class RecoveryRunRequest(BaseModel):
    mode: str = Field(default="smoke", pattern="^(smoke|full)$")


def _read_recovery_json(name: str):
    path = RECOVERY_DIR / name
    if not path.is_file():
        return None
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise HTTPException(status_code=500, detail=f"Unreadable artifact: {name}") from exc


@app.get("/api/injection-recovery/status")
def injection_recovery_status():
    """Job status, reconciled with whatever artifacts exist on disk."""
    job = recovery_manager.status()
    summary = _read_recovery_json("summary.json")

    if job["status"] == "running":
        return {"status": "running", **job}

    if job["status"] == "failed":
        return {"status": "failed", **job, "has_previous_results": summary is not None}

    if summary is not None:
        return {
            "status": "completed",
            "mode": summary.get("mode"),
            "progress": 1.0,
            "trials_done": summary.get("counts", {}).get("trials_total"),
            "trials_total": summary.get("counts", {}).get("trials_total"),
            "started_at": summary.get("started_at"),
            "finished_at": summary.get("finished_at"),
            "runtime_seconds": summary.get("runtime_seconds"),
            "error": None,
            "source": "artifacts",
        }

    return {"status": "not_run", **job}


@app.post("/api/injection-recovery/run", status_code=202)
def injection_recovery_run(request: RecoveryRunRequest):
    """Trigger the configured experiment once. Duplicate concurrent runs are refused."""
    started, status = recovery_manager.start(request.mode)
    if not started:
        raise HTTPException(
            status_code=409,
            detail="A recovery experiment is already running.",
        )
    return {"started": True, "mode": request.mode, "status": status["status"]}


@app.get("/api/injection-recovery/results")
def injection_recovery_results():
    """Summary, plot data, benchmark, and the first rows of the trial table."""
    summary = _read_recovery_json("summary.json")
    if summary is None:
        return {"status": "not_run", "message": "No completed experiment artifacts found."}

    plot_data = _read_recovery_json("plot_data.json")
    trials_path = RECOVERY_DIR / "trial_results.csv"
    preview = []
    trial_columns = []
    if trials_path.is_file():
        frame = pd.read_csv(trials_path)
        trial_columns = list(frame.columns)
        # to_json converts NaN/Inf to null so the payload stays JSON-compliant.
        preview = json.loads(frame.head(200).to_json(orient="records"))

    return {
        "status": "completed",
        "mode": summary.get("mode"),
        "summary": summary,
        "plot_data": plot_data,
        "benchmark": summary.get("benchmark"),
        "trials_preview": preview,
        "trial_columns": trial_columns,
        "artifacts": {
            name: f"/api/injection-recovery/artifacts/{name}" for name in RECOVERY_ARTIFACTS
        },
    }


@app.get("/api/injection-recovery/report", response_class=PlainTextResponse)
def injection_recovery_report():
    path = RECOVERY_DIR / "recovery_report.md"
    if not path.is_file():
        raise HTTPException(status_code=404, detail="No generated report yet.")
    return PlainTextResponse(path.read_text(encoding="utf-8"), media_type="text/markdown")


@app.get("/api/injection-recovery/artifacts/{name}")
def injection_recovery_artifact(name: str):
    """Download an allowlisted artifact. Unknown names are rejected before any path use."""
    entry = RECOVERY_ARTIFACTS.get(name)
    if entry is None:
        raise HTTPException(status_code=404, detail="Unknown artifact name.")

    relative, media_type = entry
    path = RECOVERY_DIR / relative
    if not path.is_file():
        raise HTTPException(status_code=404, detail="Artifact not available yet.")

    return FileResponse(path, media_type=media_type, filename=path.name)


@app.get("/api/detection-benchmark/results")
def detection_benchmark_results():
    summary = _read_recovery_json("summary.json")
    if summary is None:
        return {"status": "not_run", "message": "Run the recovery experiment first."}
    return {
        "status": "completed",
        "mode": summary.get("mode"),
        "benchmark": summary.get("benchmark"),
        "limitations": summary.get("limitations"),
        "provenance": summary.get("provenance"),
    }


@app.get("/api/transit-injection")
def transit_injection_preview(
    mission: str = Query(default="kepler"),
    depth_ppm: float = Query(default=150.0),
    center_index: int | None = Query(default=None),
):
    """Show a synthetic transit injected into a real light-curve window.

    Reads the processed CSV, injects a batman transit of the requested depth into
    an in-memory copy, and returns only the observations around the chosen
    transit centre. The source file is never written to.

    This endpoint visualises a simulation. It does not detect a planet, train a
    model, or reproduce the saved Phase 5 experiment.
    """
    mission = mission.lower()

    if mission not in DATASETS:
        raise HTTPException(
            status_code=404,
            detail="Unknown mission. Choose 'kepler' or 'tess'.",
        )

    if depth_ppm not in transit_injection.SUPPORTED_DEPTHS_PPM:
        raise HTTPException(
            status_code=422,
            detail=(
                "Unsupported injection depth. Choose one of "
                + ", ".join(str(int(d)) for d in transit_injection.SUPPORTED_DEPTHS_PPM)
                + " ppm."
            ),
        )

    csv_path = PROJECT_ROOT / DATASETS[mission]

    if not csv_path.is_file():
        raise HTTPException(
            status_code=404,
            detail=f"Dataset not found for mission '{mission}'.",
        )

    try:
        times, flux, excluded = transit_injection.load_light_curve(csv_path, mission)
    except (ValueError, OSError, pd.errors.ParserError) as exc:
        raise HTTPException(
            status_code=500,
            detail="Could not read the expected light-curve CSV columns.",
        ) from exc

    if times.size == 0:
        raise HTTPException(
            status_code=422,
            detail="The dataset contains no valid observations.",
        )

    centres = transit_injection.transit_centres(times, mission)

    if not centres:
        raise HTTPException(
            status_code=422,
            detail="No ephemeris-predicted transit centre is covered by the data.",
        )

    if center_index is None:
        selected = centres[0]
    else:
        matches = [item for item in centres if item["index"] == center_index]
        if not matches:
            raise HTTPException(
                status_code=422,
                detail=(
                    "center_index is not an available transit centre for this "
                    "dataset. Use one of the returned available_centers."
                ),
            )
        selected = matches[0]

    centre_time = selected["time_dataset_days"]
    window = np.abs(times - centre_time) <= transit_injection.HALF_WINDOW_DAYS
    window_times = times[window]
    window_flux = flux[window]

    dt_days = window_times - centre_time
    injected = transit_injection.inject_transit(window_flux, dt_days, depth_ppm)

    difference_ppm = (injected - window_flux) * 1e6
    measured = transit_injection.measured_depth_ppm(window_flux, injected)
    max_change = transit_injection.max_abs_change_ppm(window_flux, injected)

    bjd_offset = transit_injection.bjd_reference(mission)
    system = "BKJD" if mission == "kepler" else "TJD"

    points = [
        {
            "time": float(window_times[i]),
            "bjd_tdb": float(window_times[i] + bjd_offset),
            "original": float(window_flux[i]),
            "injected": float(injected[i]),
            "difference_ppm": float(difference_ppm[i]),
        }
        for i in range(window_times.size)
    ]

    return {
        "mission": mission,
        "target": "Kepler-10 b",
        "dataset": {
            "path": DATASETS[mission],
            "sha256": _file_sha256(str(csv_path), csv_path.stat().st_mtime_ns),
            "total_observations": int(times.size),
            "excluded_non_finite": excluded,
            "window_observations": int(window_times.size),
            "half_window_days": transit_injection.HALF_WINDOW_DAYS,
        },
        "time": {
            "column": "time",
            "unit": "days",
            "system": system,
            "definition": f"BJD_TDB - {bjd_offset:.1f}",
            "bjd_offset": bjd_offset,
            "axis_label": f"Time ({system}, BJD_TDB - {bjd_offset:.1f}) [days]",
        },
        "flux": {
            "column": "normalized_flux",
            "unit": "normalized relative flux (dimensionless, median ~ 1)",
            "axis_label": "Normalized relative flux",
        },
        "ephemeris": {
            "period_days": transit_injection.PERIOD_DAYS,
            "t0_bjd_tdb": transit_injection.TRANSIT_EPOCH_BJD_TDB,
            "bjd_offset": bjd_offset,
            "source": "scripts/transit_analysis.py (NASA Exoplanet Archive values)",
        },
        "model": {
            "name": "batman quadratic limb darkening",
            "a_over_rstar": transit_injection.A_OVER_RSTAR,
            "inclination_deg": transit_injection.INCLINATION_DEG,
            "u1": transit_injection.U1,
            "u2": transit_injection.U2,
            "radius_ratio": "sqrt(depth_ppm * 1e-6)",
            "injection_formula": "injected = flux + median(flux_window) * (model - 1)",
        },
        "center": selected,
        "available_centers": centres,
        "points": points,
        "diagnostics": {
            "n_points": int(window_times.size),
            "requested_depth_ppm": float(depth_ppm),
            "measured_depth_ppm": measured,
            "max_abs_change_ppm": max_change,
            "measured_depth_definition": (
                "max(original - injected) * 1e6 over the returned window, i.e. the "
                "deepest flux decrement the injection actually produced. Because the "
                "injection only removes flux, this equals max|injected - original| * 1e6."
            ),
            "limitations": [
                "The requested depth parameterises rp = sqrt(depth * 1e-6); limb "
                "darkening makes the central flux decrement larger than that value.",
                "Injection is applied to the stored processed flux, while the Phase 5 "
                "builder injected into detrended flux. The formula is identical but the "
                "displayed baseline is not detrended.",
                "The processed CSVs carry no quality column, so no quality-bit mask "
                "can be applied here; non-finite values are dropped instead.",
                "Measured depth is limited by cadence: with 29.4-minute Kepler sampling "
                "the transit centre may fall between exposures, so the measured value is "
                "a lower bound on the true injected decrement.",
            ],
        },
        "scientific_notice": (
            "The injected transit is simulated and overlaid on real observations. It is "
            "not a detection, it does not reproduce the saved Phase 5 experiment, and no "
            "model is trained or evaluated by this view."
        ),
    }


@app.get("/api/lightcurve/{mission}")
def get_lightcurve(
    mission: str,
    max_points: int = Query(default=2000, ge=100, le=10000),
):
    """Return validated, optionally downsampled observations for plotting."""
    mission = mission.lower()

    if mission not in DATASETS:
        raise HTTPException(
            status_code=404,
            detail="Unknown mission. Choose 'kepler' or 'tess'.",
        )

    csv_path = PROJECT_ROOT / DATASETS[mission]

    if not csv_path.is_file():
        raise HTTPException(
            status_code=404,
            detail=f"Dataset not found for mission '{mission}'.",
        )

    try:
        df = pd.read_csv(
            csv_path,
            usecols=["time", "normalized_flux"],
        )
    except (ValueError, OSError, pd.errors.ParserError) as exc:
        raise HTTPException(
            status_code=500,
            detail="Could not read the expected light-curve CSV columns.",
        ) from exc

    # Coerce malformed values and discard non-finite measurements.
    for column in ("time", "normalized_flux"):
        df[column] = pd.to_numeric(df[column], errors="coerce")

    df = df.dropna(subset=["time", "normalized_flux"])

    finite_mask = df["time"].map(math.isfinite) & df["normalized_flux"].map(math.isfinite)

    df = df.loc[finite_mask].sort_values("time").reset_index(drop=True)

    total_valid = len(df)

    if total_valid == 0:
        raise HTTPException(
            status_code=422,
            detail="The dataset contains no valid observations.",
        )

    # Select evenly spaced rows to keep large charts responsive.
    if total_valid > max_points:
        indices = [round(i * (total_valid - 1) / (max_points - 1)) for i in range(max_points)]
        chart_df = df.iloc[indices]
    else:
        chart_df = df

    return {
        "mission": mission,
        "target": "Kepler-10 b",
        "columns": ["time", "normalized_flux"],
        "total_valid_observations": total_valid,
        "returned_points": len(chart_df),
        "sampled": len(chart_df) < total_valid,
        "time_unit": "days in the source dataset time convention",
        "flux_unit": "normalized flux",
        "data": chart_df.to_dict(orient="records"),
    }
