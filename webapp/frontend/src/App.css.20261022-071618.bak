@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap');

:root {
  font-family: 'DM Sans', sans-serif;
  color: #e6edf7;
  background: #080f1b;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  --bg: #080f1b;
  --panel: #101b2b;
  --panel-2: #142237;
  --border: #22334a;
  --muted: #8fa2bc;
  --blue: #65c9f4;
  --green: #5be0b1;
}

* { box-sizing: border-box; }
body { margin: 0; min-width: 320px; min-height: 100vh; }
button { font: inherit; cursor: pointer; }
button:focus-visible { outline: 2px solid var(--blue); outline-offset: 3px; }
.app-shell { min-height: 100vh; }
.sidebar { width: 246px; background: #0b1422; border-right: 1px solid #1c2b40; position: fixed; inset: 0 auto 0 0; padding: 25px 15px; display: flex; flex-direction: column; z-index: 2; }
.brand { display: flex; gap: 11px; align-items: center; padding: 0 9px 31px; }
.brand-mark { display: grid; place-items: center; width: 40px; height: 40px; border: 1px solid #2b6682; border-radius: 12px; color: var(--blue); background: #10283a; }
.brand strong, .brand span { display: block; }
.brand strong { font: 700 13px 'Space Grotesk', sans-serif; letter-spacing: .08em; }
.brand span { color: #7890aa; font: 9px 'DM Mono', monospace; letter-spacing: .07em; margin-top: 4px; }
.side-label, .eyebrow { color: #7591ad; font: 10px 'DM Mono', monospace; letter-spacing: .12em; }
.side-label { padding: 0 10px; margin-bottom: 12px; }
nav { display: grid; gap: 5px; }
.nav-item { border: 1px solid transparent; color: #91a4bc; background: transparent; padding: 12px 11px; display: flex; align-items: center; gap: 12px; border-radius: 8px; text-align: left; font-size: 13px; }
.nav-item:hover { color: #e7f4ff; background: #101f32; }
.nav-item.active { color: #83d7fa; background: #10283a; border-color: #24445a; }
.sidebar-bottom { margin-top: auto; }
.target-mini { display: flex; align-items: center; gap: 10px; padding: 12px 9px; background: #101d2e; border: 1px solid #1d3046; border-radius: 9px; }
.planet-icon { width: 38px; height: 38px; border-radius: 50%; display: grid; place-items: center; color: #8cdcff; background: radial-gradient(circle at 30% 25%, #286080, #13283c 70%); }
.target-mini strong, .target-mini span { display: block; }
.target-mini strong { font-size: 12px; }
.target-mini span { margin-top: 5px; font: 9px 'DM Mono', monospace; color: #7f96af; }
.sidebar-note { display: flex; gap: 7px; align-items: flex-start; color: #8197b0; font-size: 10px; line-height: 1.5; padding: 14px 6px 0; }
.sidebar-note svg { color: var(--green); flex-shrink: 0; }
.main-panel { margin-left: 246px; min-height: 100vh; }
.topbar { height: 65px; display: flex; align-items: center; justify-content: space-between; padding: 0 34px; border-bottom: 1px solid #1b2a3e; background: #0b1421; }
.breadcrumbs, .top-actions { display: flex; align-items: center; gap: 12px; }
.breadcrumbs { font: 10px 'DM Mono', monospace; letter-spacing: .09em; color: #8195ae; }
.breadcrumbs strong { color: #d9e8f6; font-weight: 500; }
.crumb-sep { color: #435871; }
.top-actions { gap: 10px; }
.status-pill { display: flex; gap: 7px; align-items: center; border: 1px solid #2b3d52; border-radius: 20px; padding: 7px 10px; color: #9db0c6; font: 9px 'DM Mono', monospace; }
.status-pill.online { color: #70e6b7; border-color: #245747; }
.status-pill.offline { color: #ffb4a9; border-color: #69413f; }
.status-dot { display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: currentColor; flex-shrink: 0; }
.icon-button { display: grid; place-items: center; width: 32px; height: 32px; border: 1px solid var(--border); color: #a6bad0; background: #111f31; border-radius: 8px; }
.content { max-width: 1450px; margin: 0 auto; padding: 29px 34px 20px; }
.hero { min-height: 270px; overflow: hidden; display: grid; grid-template-columns: 1.25fr .75fr; border: 1px solid #263b52; border-radius: 13px; background: radial-gradient(ellipse at 78% 45%, #14334a 0, #101f33 34%, #101b2b 72%); position: relative; }
.hero-copy { padding: 32px 30px; position: relative; z-index: 1; }
.hero .eyebrow { display: flex; gap: 7px; align-items: center; color: #77cbee; }
h1, h2, h3, p { margin-top: 0; }
h1 { max-width: 550px; margin: 17px 0 12px; font: 600 clamp(25px, 3vw, 36px)/1.15 'Space Grotesk', sans-serif; letter-spacing: -.04em; }
.hero-copy > p { max-width: 530px; color: #9cb0c7; font-size: 13px; line-height: 1.8; }
.hero-buttons { display: flex; flex-wrap: wrap; gap: 9px; margin-top: 23px; }
.primary-button, .secondary-button { display: inline-flex; align-items: center; justify-content: center; gap: 9px; border-radius: 7px; padding: 10px 13px; font-size: 11px; font-weight: 600; }
.primary-button { color: #06131f; background: #79d4f5; border: 1px solid #79d4f5; }
.primary-button:hover { background: #a0e4fb; }
.secondary-button { color: #c1d3e6; background: #142337; border: 1px solid #31455c; }
.secondary-button:hover { background: #1a3049; }
.hero-art { min-height: 260px; position: relative; overflow: hidden; }
.orbit-ring { position: absolute; width: 260px; height: 115px; border: 1px solid #3c7994; border-radius: 50%; left: 50%; top: 44%; transform: translate(-50%,-50%) rotate(-30deg); }
.ring-two { width: 315px; height: 148px; border-color: #2a536e; transform: translate(-50%,-50%) rotate(38deg); }
.planet { position: absolute; border-radius: 50%; }
.planet-large { width: 111px; height: 111px; left: 50%; top: 42%; transform: translate(-50%,-50%); background: radial-gradient(circle at 29% 25%, #94e2fa, #317da1 34%, #153b5a 67%, #091a2d 100%); box-shadow: 0 0 45px #3686aa55, inset -14px -9px 25px #050d1c; }
.planet-small { width: 18px; height: 18px; left: 77%; top: 20%; background: #e0bb85; box-shadow: 0 0 20px #e0bb8577; }
.star { position: absolute; width: 3px; height: 3px; border-radius: 50%; background: #a9e7ff; box-shadow: 0 0 9px #8adfff; }
.star-one { left: 18%; top: 20%; }.star-two { left: 77%; top: 73%; }.star-three { left: 30%; top: 77%; }
.art-caption { position: absolute; bottom: 17px; left: 0; right: 0; text-align: center; color: #6f9ab7; font: 8px 'DM Mono', monospace; letter-spacing: .12em; }
.art-caption span { color: #72d2f5; padding: 0 5px; }
.section-heading { display: flex; justify-content: space-between; align-items: end; gap: 15px; margin: 29px 0 14px; }
.section-heading h2 { margin: 6px 0 0; font: 600 19px 'Space Grotesk', sans-serif; letter-spacing: -.02em; }
.muted { color: #7e93ab; font-size: 10px; }
.metric-grid { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: 12px; }
.metric-card { background: #101b2b; border: 1px solid #23344a; border-radius: 10px; padding: 16px; min-width: 0; }
.metric-top { display: flex; justify-content: space-between; gap: 6px; color: #91a5bc; font-size: 11px; }
.metric-top svg { color: #6dc7e9; }
.metric-value { margin-top: 17px; color: #ecf6ff; font: 600 clamp(19px,2vw,27px) 'Space Grotesk', sans-serif; overflow-wrap: anywhere; }
.metric-value-small { font-size: 16px; }
.metric-foot { margin-top: 8px; color: #7187a0; font-size: 10px; }
.artifact-list { border: 1px solid #22334a; border-radius: 10px; overflow: hidden; background: #101b2b; }
.artifact-row { display: grid; grid-template-columns: 38px minmax(0,1fr) auto 68px; align-items: center; gap: 12px; padding: 13px 16px; border-bottom: 1px solid #1f3044; }
.artifact-row:last-child { border-bottom: 0; }
.artifact-icon { width: 36px; height: 36px; display: grid; place-items: center; color: #76ccec; background: #14283a; border: 1px solid #263d52; border-radius: 8px; }
.artifact-info { min-width: 0; }
.artifact-info strong { display: block; font-size: 11px; font-weight: 600; }
.artifact-info code { display: block; margin-top: 5px; color: #718aa5; font: 10px 'DM Mono', monospace; overflow-wrap: anywhere; }
.artifact-status { display: flex; align-items: center; gap: 7px; font: 9px 'DM Mono', monospace; white-space: nowrap; }
.artifact-status.found { color: #6fe0b0; }.artifact-status.missing { color: #e7b67e; }
.artifact-size { text-align: right; color: #8095ad; font: 10px 'DM Mono', monospace; }
.workspace-card { margin-top: 24px; padding: 25px; border: 1px solid #263a51; border-radius: 12px; background: linear-gradient(145deg,#111f32,#0d1725); }
.workspace-icon { display: grid; place-items: center; width: 44px; height: 44px; color: #7ad7f5; background: #153047; border: 1px solid #294c64; border-radius: 10px; }
.workspace-card h2 { margin: 19px 0 10px; font: 600 22px 'Space Grotesk', sans-serif; }
.workspace-card > p { max-width: 750px; color: #9aafc6; font-size: 13px; line-height: 1.8; }
.notice { display: flex; align-items: center; gap: 9px; color: #83dfb8; font-size: 11px; padding: 13px; background: #10271f; border: 1px solid #214b3c; border-radius: 7px; margin: 18px 0; }
.scientific-notice { padding-left: 13px; border-left: 2px solid #64c8eb; }
.workspace-card h3 { margin-top: 25px; font-size: 13px; }
.method-list { padding: 0; list-style: none; }
.method-list li { display: flex; justify-content: space-between; gap: 15px; padding: 12px 0; border-bottom: 1px solid #26374b; font-size: 11px; }
.method-list code { color: #76ddb2; font: 10px 'DM Mono', monospace; }
.error-banner { display: flex; gap: 10px; align-items: center; margin-bottom: 16px; padding: 12px 14px; border: 1px solid #70423e; background: #291b20; border-radius: 8px; color: #ffc0b5; font-size: 12px; }
.error-banner span { flex: 1; }.error-banner button { color: #ffc0b5; border: 1px solid #70423e; background: transparent; border-radius: 5px; padding: 5px 9px; }
.empty-state { padding: 20px; color: var(--muted); font-size: 12px; }
.footer { display: flex; justify-content: space-between; gap: 15px; margin-top: 31px; padding: 18px 0 5px; border-top: 1px solid #1e2c40; color: #71859d; font: 9px 'DM Mono', monospace; }
.footer div { display: flex; align-items: center; gap: 7px; }.footer svg { color: #6ac9ed; }.footer div span { color: #38536c; }

@media (max-width: 1050px) {
  .sidebar { width: 205px; }.main-panel { margin-left: 205px; }
  .metric-grid { grid-template-columns: repeat(2,minmax(0,1fr)); }
  .hero { grid-template-columns: 1fr .55fr; }.hero-art { opacity: .8; }
}
@media (max-width: 700px) {
  .sidebar { position: static; width: auto; padding: 14px; border-right: 0; border-bottom: 1px solid #1c2b40; }
  .brand { padding: 0 5px 14px; }.sidebar .side-label, .sidebar-bottom { display: none; }
  nav { display: flex; overflow-x: auto; }.nav-item { white-space: nowrap; padding: 9px; font-size: 11px; gap: 7px; }
  .main-panel { margin-left: 0; }.topbar { height: 54px; padding: 0 15px; }.content { padding: 18px 14px; }
  .hero { grid-template-columns: 1fr; }.hero-copy { padding: 24px 20px; }.hero-art { position: absolute; right: -50px; top: 10px; width: 200px; opacity: .18; }
  .hero-copy { z-index: 1; }.hero-copy > p { max-width: 450px; }
  .section-heading { align-items: start; flex-direction: column; }.metric-grid { gap: 8px; }.metric-card { padding: 12px; }
  .artifact-row { grid-template-columns: 32px minmax(0,1fr); }.artifact-status { grid-column: 2; }.artifact-size { display: none; }
  .footer { flex-direction: column; }.breadcrumbs { font-size: 9px; }.status-pill { font-size: 8px; }
}
