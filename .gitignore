.venv/
.venv-pages/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Downloaded astronomy data and local cache
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/processed/kepler_kepler_10.csv
!data/processed/tess_kepler_10.csv

# Local environment files; the Pages mode flag contains no secrets and is tracked
.env
.env.*
!webapp/frontend/.env.pages

# Generated static API copies are rebuilt by the Pages workflow
webapp/frontend/public/api/

# Local agent/tooling state must never enter a commit
HOME/
.claude/

# OS / editor noise and local backups
.DS_Store
Thumbs.db
*.bak

# Keep generated figures only when intentionally reviewed and committed
